{
  "name": "farpane-packages",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "farpane-packages.spidey.in", "custom_domain": true }],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/rpm/*", "/apt/pool/*"]
  }
}
